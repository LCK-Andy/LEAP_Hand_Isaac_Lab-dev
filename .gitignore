# Omniverse
**/*.dmp
**/.thumbs

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!/.vscode/

# Local agent tooling
.zcode/

# Outputs
**/runs/*
**/logs/*
**/recordings/*
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

source/LEAP_Isaaclab/LEAP_Isaaclab/tasks/leap_crawler/*
source/LEAP_Isaaclab/LEAP_Isaaclab/deployment_scripts/leap_crawler.py
source/LEAP_Isaaclab/LEAP_Isaaclab/tasks/leap_three_axis_reorient/*
source/LEAP_Isaaclab/build/*

# YCB meshes (large binary files, re-download with scripts/download_ycb.py)
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/ycb/*/
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/ycb/*.png
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/ycb/*.obj
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/ycb/*.stl
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/ycb/*.mtl
# YCB downloaded meshes (large; regenerate with scripts/download_ycb.py)
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/ycb/[0-9]*/

# Generated/derived USD & mesh assets (regenerate via scripts/build_*_leap_urdf.py or converters)
*.usd
*.usda
*.usdc
*.obj
*.usd.bak

# Mimosa security-scan local state (scan history, hook state, finding ledger, reports)
.mimosa/

# Local agent-tool state (excluded from remote rsync too)
.claude/
.serena/
.mcp.json

# Smoke-test image outputs (written by scripts/*_smoke.py)
scripts/*_smoke_rgb.png
scripts/*_smoke_depth.png

# URDF build pipeline state
source/LEAP_Isaaclab/LEAP_Isaaclab/assets/urdf/.asset_hash
